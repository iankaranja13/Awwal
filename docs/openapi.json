{
  "openapi": "3.1.0",
  "info": {
    "title": "Awwal API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe.",
        "description": "Return service liveness and version.\n\nArgs:\n    settings: Injected application settings.\n\nReturns:\n    The health response payload.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Post Session",
        "description": "Create an anonymous session and return its token.\n\nArgs:\n    request: Incoming request (for rate limiting).\n    session: Request database session.\n    settings: Application settings.\n    body: Optional session creation request.\n\nReturns:\n    Created session with access token.",
        "operationId": "post_session_api_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SessionRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/consent": {
      "get": {
        "tags": [
          "consent"
        ],
        "summary": "Get Consent",
        "description": "Return the current consent state with full history.\n\nArgs:\n    user: Authenticated user.\n    session: Request database session.\n\nReturns:\n    State and ledger entries oldest first.",
        "operationId": "get_consent_api_v1_consent_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentHistoryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "consent"
        ],
        "summary": "Post Consent",
        "description": "Grant or revoke one consent scope.\n\nArgs:\n    user: Authenticated user.\n    session: Request database session.\n    body: Scope and grant flag.\n\nReturns:\n    Current consent state for all scopes.",
        "operationId": "post_consent_api_v1_consent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/intake/schema": {
      "get": {
        "tags": [
          "intake"
        ],
        "summary": "Get Schema",
        "description": "Return the bilingual intake schema.\n\nArgs:\n    _user: Authenticated user (unused beyond authentication).\n    settings: Application settings.\n\nReturns:\n    Versioned schema document.",
        "operationId": "get_schema_api_v1_intake_schema_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeSchemaDocument"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/intake": {
      "get": {
        "tags": [
          "intake"
        ],
        "summary": "Get Intake",
        "description": "Return the caller's decrypted intake answers.\n\nArgs:\n    user: Authenticated user.\n    session: Request database session.\n    settings: Application settings.\n\nReturns:\n    Stored answers (empty when never saved).",
        "operationId": "get_intake_api_v1_intake_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeGetResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "intake"
        ],
        "summary": "Put Intake",
        "description": "Save intake answers (partial updates allowed).\n\nArgs:\n    user: Authenticated user with intake consent.\n    session: Request database session.\n    settings: Application settings.\n    body: Answers by item id.\n\nReturns:\n    Save receipt with stored ids.",
        "operationId": "put_intake_api_v1_intake_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/assess": {
      "post": {
        "tags": [
          "assessments"
        ],
        "summary": "Post Assess",
        "description": "Run the assessment pipeline for the caller.\n\nArgs:\n    user: Authenticated user with intake consent.\n    session: Request database session.\n    settings: Application settings.\n    language: Response language.\n\nReturns:\n    Full assessment response.",
        "operationId": "post_assess_api_v1_assess_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{assessment_id}": {
      "get": {
        "tags": [
          "assessments"
        ],
        "summary": "Get Assessment",
        "description": "Return one stored assessment with its latest explanation.\n\nArgs:\n    user: Authenticated user.\n    session: Request database session.\n    settings: Application settings.\n    assessment_id: Assessment id.\n\nReturns:\n    Full assessment response.",
        "operationId": "get_assessment_api_v1_assessments__assessment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Assessment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trace/{assessment_id}": {
      "get": {
        "tags": [
          "trace"
        ],
        "summary": "Get Assessment Trace",
        "description": "Return the workflow trace for one assessment.\n\nArgs:\n    user: Authenticated user.\n    session: Request database session.\n    assessment_id: Assessment id.\n\nReturns:\n    Trace response with ordered steps.",
        "operationId": "get_assessment_trace_api_v1_trace__assessment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Assessment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerIn": {
        "properties": {
          "value": {
            "title": "Value",
            "description": "Provided answer value."
          },
          "status": {
            "$ref": "#/components/schemas/ItemStatus",
            "description": "Answer status."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AnswerIn",
        "description": "One submitted answer."
      },
      "AssessFlag": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Flag id."
          },
          "state": {
            "$ref": "#/components/schemas/FlagState",
            "description": "Three-state outcome."
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Clinical domain."
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Display label in the response language."
          },
          "reason_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Fields",
            "description": "Decisive fields."
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields",
            "description": "Missing required fields."
          },
          "modifiable": {
            "type": "boolean",
            "title": "Modifiable",
            "description": "Whether the user can act on this factor."
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Guideline source hint (unvalidated)."
          },
          "requires_clinical_validation": {
            "type": "boolean",
            "title": "Requires Clinical Validation",
            "description": "True until a validation flow exists."
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Plain-language explanation."
          },
          "why_we_ask": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why We Ask",
            "description": "Why text for missing fields."
          }
        },
        "type": "object",
        "required": [
          "id",
          "state",
          "domain",
          "label",
          "modifiable",
          "source",
          "requires_clinical_validation",
          "explanation"
        ],
        "title": "AssessFlag",
        "description": "One flag as served in assessment responses."
      },
      "AssessResponse": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Assessment Id",
            "description": "Assessment id."
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version",
            "description": "Combined rule version string."
          },
          "language": {
            "$ref": "#/components/schemas/Language",
            "description": "Response language."
          },
          "urgent": {
            "type": "boolean",
            "title": "Urgent",
            "description": "Whether a red flag short-circuited the pipeline."
          },
          "route": {
            "$ref": "#/components/schemas/Route",
            "description": "Selected route."
          },
          "route_reason": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Route Reason",
            "description": "Driver rule ids."
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/AssessFlag"
            },
            "type": "array",
            "title": "Flags",
            "description": "Flag outcomes."
          },
          "missing_items": {
            "items": {
              "$ref": "#/components/schemas/MissingItem"
            },
            "type": "array",
            "title": "Missing Items",
            "description": "Missing key items."
          },
          "next_step": {
            "$ref": "#/components/schemas/NextStep",
            "description": "Next step."
          },
          "static_safety_message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StaticSafetyMessage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Urgent static message."
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "description": "Screening disclaimer."
          },
          "explanation_source": {
            "$ref": "#/components/schemas/ExplanationSource"
          },
          "trace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trace Id",
            "description": "Workflow trace id."
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "rules_version",
          "language",
          "urgent",
          "route",
          "next_step",
          "disclaimer",
          "explanation_source",
          "trace_id"
        ],
        "title": "AssessResponse",
        "description": "Full assessment response."
      },
      "ConsentHistoryResponse": {
        "properties": {
          "state": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/ConsentScope"
            },
            "type": "object",
            "title": "State",
            "description": "Granted flag per scope."
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "description": "Current policy version."
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ConsentRecord"
            },
            "type": "array",
            "title": "History",
            "description": "Ledger entries oldest first."
          }
        },
        "type": "object",
        "required": [
          "state",
          "policy_version",
          "history"
        ],
        "title": "ConsentHistoryResponse",
        "description": "Current consent state with full history."
      },
      "ConsentRecord": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/ConsentScope",
            "description": "Consent scope."
          },
          "granted": {
            "type": "boolean",
            "title": "Granted",
            "description": "True grants, False revokes."
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "description": "Policy version in force."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Entry timestamp (UTC)."
          }
        },
        "type": "object",
        "required": [
          "scope",
          "granted",
          "policy_version",
          "created_at"
        ],
        "title": "ConsentRecord",
        "description": "One ledger entry."
      },
      "ConsentRequest": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/ConsentScope",
            "description": "Consent scope."
          },
          "granted": {
            "type": "boolean",
            "title": "Granted",
            "description": "True grants, False revokes."
          }
        },
        "type": "object",
        "required": [
          "scope",
          "granted"
        ],
        "title": "ConsentRequest",
        "description": "Consent grant or revocation request."
      },
      "ConsentScope": {
        "type": "string",
        "enum": [
          "intake",
          "share_with_clinician",
          "reminders",
          "aggregate_analytics"
        ],
        "title": "ConsentScope",
        "description": "Consent scope for data use."
      },
      "ConsentStateResponse": {
        "properties": {
          "state": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/ConsentScope"
            },
            "type": "object",
            "title": "State",
            "description": "Granted flag per scope."
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "description": "Current policy version."
          }
        },
        "type": "object",
        "required": [
          "state",
          "policy_version"
        ],
        "title": "ConsentStateResponse",
        "description": "Current consent state for all scopes."
      },
      "ExplanationSource": {
        "type": "string",
        "enum": [
          "llm",
          "template",
          "static"
        ],
        "title": "ExplanationSource",
        "description": "Explanation origin."
      },
      "FlagState": {
        "type": "string",
        "enum": [
          "PRESENT",
          "NOT_PRESENT_FROM_PROVIDED_DATA",
          "NOT_ASSESSABLE"
        ],
        "title": "FlagState",
        "description": "Three-state screening flag outcome."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service status (``ok`` when healthy).",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Application version."
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Deployment environment name."
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Liveness probe response."
      },
      "IntakeGetResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "description": "Schema version stored."
          },
          "answers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AnswerIn"
            },
            "type": "object",
            "title": "Answers",
            "description": "Answers by item id."
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "Storage timestamp (UTC), if ever saved."
          }
        },
        "type": "object",
        "required": [
          "schema_version",
          "answers",
          "updated_at"
        ],
        "title": "IntakeGetResponse",
        "description": "Decrypted stored intake answers."
      },
      "IntakeItem": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id",
            "description": "Stable item id."
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "title": "Domain",
            "description": "Clinical domain."
          },
          "type": {
            "$ref": "#/components/schemas/ItemType",
            "description": "Answer type."
          },
          "required_for_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required For Flags",
            "description": "Rules using this item."
          },
          "label": {
            "$ref": "#/components/schemas/Label",
            "description": "Bilingual question text."
          },
          "why_we_ask": {
            "$ref": "#/components/schemas/Label",
            "description": "Bilingual reason for asking."
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ItemOption"
            },
            "type": "array",
            "title": "Options",
            "description": "Choice options."
          },
          "sensitive": {
            "type": "boolean",
            "title": "Sensitive",
            "description": "Whether the item holds sensitive content."
          },
          "optional_by_design": {
            "type": "boolean",
            "title": "Optional By Design",
            "description": "Whether the item is optional by design."
          },
          "needs_native_review": {
            "type": "boolean",
            "title": "Needs Native Review",
            "description": "True until Arabic review exists."
          },
          "min_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Value",
            "description": "Minimum for number items."
          },
          "max_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Value",
            "description": "Maximum for number items."
          },
          "max_length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Length",
            "description": "Maximum length for text items."
          }
        },
        "type": "object",
        "required": [
          "id",
          "domain",
          "type",
          "label",
          "why_we_ask",
          "sensitive",
          "optional_by_design",
          "needs_native_review"
        ],
        "title": "IntakeItem",
        "description": "One intake schema item."
      },
      "IntakeResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "description": "Schema version stored."
          },
          "saved_item_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Saved Item Ids",
            "description": "Item ids saved from this request."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Storage timestamp (UTC)."
          }
        },
        "type": "object",
        "required": [
          "schema_version",
          "saved_item_ids",
          "updated_at"
        ],
